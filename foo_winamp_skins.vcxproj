  </ImportGroup>
  <PropertyGroup Label="UserMacros">
    <!-- Portable foobar2000 installs next to the repo, used for debugging and auto-deploy. -->
    <Fb2kDir Condition="'$(Platform)'=='x64'">$(MSBuildProjectDirectory)\..\foobar2000_x64\</Fb2kDir>
    <Fb2kDir Condition="'$(Platform)'=='Win32'">$(MSBuildProjectDirectory)\..\foobar2000_x32\</Fb2kDir>
    <Fb2kUserComponents Condition="'$(Platform)'=='x64'">$(Fb2kDir)profile\user-components-x64\$(ProjectName)\</Fb2kUserComponents>
    <Fb2kUserComponents Condition="'$(Platform)'=='Win32'">$(Fb2kDir)profile\user-components\$(ProjectName)\</Fb2kUserComponents>
  </PropertyGroup>
  <PropertyGroup>
    <LocalDebuggerCommand>$(Fb2kDir)foobar2000.exe</LocalDebuggerCommand>
    <LocalDebuggerWorkingDirectory>$(Fb2kDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_USRDLL;MINIZ_NO_STDIO;MINIZ_NO_ARCHIVE_WRITING_APIS;MINIZ_NO_ZLIB_COMPATIBLE_NAMES;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\src;$(MSBuildProjectDirectory)\3rdParty\foobar2000_sdk;$(MSBuildProjectDirectory)\3rdParty\foobar2000_sdk\foobar2000;$(MSBuildProjectDirectory)\3rdParty\WTL\Include;$(MSBuildProjectDirectory)\3rdParty\miniz;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <DisableAnalyzeExternal>true</DisableAnalyzeExternal>
      <AdditionalOptions>/utf-8 /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>$(MSBuildProjectDirectory)\3rdParty\foobar2000_sdk\foobar2000\shared\shared-$(Platform).lib;msimg32.lib;winmm.lib;shlwapi.lib;windowscodecs.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Message>Deploying to portable foobar2000 (if present)...</Message>
      <Command>if exist "$(Fb2kDir)foobar2000.exe" (
  if not exist "$(Fb2kUserComponents)" mkdir "$(Fb2kUserComponents)"
  copy /Y "$(TargetPath)" "$(Fb2kUserComponents)" || echo warning: deploy failed, is foobar2000 running?
  if exist "$(OutDir)$(TargetName).pdb" copy /Y "$(OutDir)$(TargetName).pdb" "$(Fb2kUserComponents)" &gt;nul
)
exit /b 0</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
