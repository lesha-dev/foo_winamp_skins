<Project>
  <!-- VS 2026 ships only v145; VS 2022 has v143. Override with /p:WszToolset=... if needed. -->
  <PropertyGroup>
    <WszToolset Condition="'$(WszToolset)' == '' and '$(VisualStudioVersion)' == '17.0'">v143</WszToolset>
    <WszToolset Condition="'$(WszToolset)' == ''">v145</WszToolset>
    <PlatformToolset>$(WszToolset)</PlatformToolset>
  </PropertyGroup>
  <!-- All build output in one place, the SDK projects included (they'd otherwise write to Release\, x64\):
       binaries in out\<Platform>\<Configuration>\, intermediates in out\obj\<Project>\<Platform>\<Configuration>\. -->
  <PropertyGroup>
    <WszRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</WszRoot>
    <OutDir>$(WszRoot)out\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(WszRoot)out\obj\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <!-- The build log otherwise goes to <project>\<Configuration>\ next to the project file. -->
  <ItemDefinitionGroup>
    <BuildLog>
      <Path>$(WszRoot)out\obj\$(ProjectName)\$(Platform)\$(Configuration)\$(MSBuildProjectName).log</Path>
    </BuildLog>
  </ItemDefinitionGroup>
</Project>
