#include <winres.h>
#include "version.h"
#include "resource.h"

IDD_RENAME DIALOGEX 0, 0, 220, 62
STYLE DS_SETFONT | DS_FIXEDSYS | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename window"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Title (empty = element's own):", IDC_STATIC, 7, 7, 206, 8
    EDITTEXT        IDC_RENAME_EDIT, 7, 18, 206, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 109, 41, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 163, 41, 50, 14
END

IDD_PREFS DIALOGEX 0, 0, 332, 288
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Skins:", IDC_STATIC, 7, 7, 130, 8
    LISTBOX         IDC_SKIN_LIST, 7, 18, 130, 245, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Preview:", IDC_STATIC, 143, 7, 183, 8
    CONTROL         "", IDC_PREVIEW, "Static", SS_OWNERDRAW, 143, 18, 183, 72
    EDITTEXT        IDC_SKIN_INFO, 143, 94, 183, 169, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT           "Folder:", IDC_STATIC, 7, 270, 26, 8
    EDITTEXT        IDC_FOLDER, 35, 268, 235, 12, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "...", IDC_BROWSE_FOLDER, 274, 267, 16, 14
    PUSHBUTTON      "Open", IDC_OPEN_FOLDER, 292, 267, 16, 14
    PUSHBUTTON      "Refresh", IDC_REFRESH, 310, 267, 16, 14
END

IDD_PREFS_OPTIONS DIALOGEX 0, 0, 332, 279
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "General", IDC_STATIC, 7, 7, 319, 40
    AUTOCHECKBOX    "Winamp hotkeys (Z X C V B L, arrows, Ctrl+D/A/W)", IDC_WINAMP_HOTKEYS, 14, 19, 300, 10
    AUTOCHECKBOX    "Enable balance DSP", IDC_BALANCE_DSP, 14, 32, 84, 10
    LTEXT           "center snap:", IDC_BALANCE_SNAP_LABEL, 100, 33, 44, 8
    EDITTEXT        IDC_BALANCE_SNAP, 146, 31, 22, 12, ES_NUMBER
    LTEXT           "%", IDC_BALANCE_SNAP_PCT, 171, 33, 10, 8
    GROUPBOX        "Display", IDC_STATIC, 7, 52, 319, 159
    AUTOCHECKBOX    "Dim window titlebars when not in focus", IDC_DIM_TITLEBARS, 14, 64, 300, 10
    AUTOCHECKBOX    "Dock skinned windows at", IDC_SNAP, 14, 77, 94, 10
    EDITTEXT        IDC_SNAP_PX, 109, 76, 22, 12, ES_NUMBER
    LTEXT           "pixels (hold Shift while dragging to invert)", IDC_STATIC, 135, 78, 180, 8
    AUTOCHECKBOX    "Enable smooth resizing of the playlist window", IDC_SMOOTH_RESIZE, 14, 91, 300, 10
    AUTOCHECKBOX    "Use double size setting on equalizer as well as main window", IDC_EQ_DSIZE, 14, 104, 300, 10
    AUTOCHECKBOX    "Always show Clutterbar in main window", IDC_CLUTTERBAR, 14, 117, 300, 10
    AUTOCHECKBOX    "Oldschool playlist button behavior (hold, pick on release)", IDC_OLDSCHOOL_PL, 14, 130, 300, 10
    AUTOCHECKBOX    "Display tooltips in Winamp's windows", IDC_TOOLTIPS, 14, 143, 300, 10
    AUTOCHECKBOX    "Use skinned mouse cursors", IDC_SKIN_CURSORS, 14, 156, 300, 10
    AUTOCHECKBOX    "Use bitmap font for main window title display (no international support)", IDC_TITLE_BITMAP, 14, 169, 300, 10
    AUTOCHECKBOX    "Use alternative font style when 'Double size' is enabled", IDC_TITLE_ALT, 24, 182, 290, 10
    AUTOCHECKBOX    "Use skin's font in Default UI's Playlist View", IDC_PLVIEW_FONT, 14, 195, 300, 10
    GROUPBOX        "Title formatting", IDC_STATIC, 7, 216, 319, 59
    LTEXT           "Main window title:", IDC_STATIC, 14, 230, 84, 8
    EDITTEXT        IDC_FORMAT_MAIN, 100, 228, 219, 12, ES_AUTOHSCROLL
    LTEXT           "Playlist entry:", IDC_STATIC, 14, 245, 84, 8
    EDITTEXT        IDC_FORMAT_PL, 100, 243, 219, 12, ES_AUTOHSCROLL
    LTEXT           "Playlist shade title:", IDC_STATIC, 14, 260, 84, 8
    EDITTEXT        IDC_FORMAT_PL_SHADE, 100, 258, 219, 12, ES_AUTOHSCROLL
END

IDD_PREFS_VIS DIALOGEX 0, 0, 332, 200
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Mode", IDC_STATIC, 7, 7, 319, 28
    AUTORADIOBUTTON "Spectrum analyzer", IDC_VIS_SPECTRUM, 14, 19, 90, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Oscilloscope", IDC_VIS_SCOPE, 110, 19, 90, 10
    AUTORADIOBUTTON "Off", IDC_VIS_OFF, 206, 19, 90, 10
    GROUPBOX        "Spectrum analyzer", IDC_STATIC, 7, 40, 319, 52
    AUTORADIOBUTTON "Normal style", IDC_VIS_NORMAL, 14, 52, 90, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Fire style", IDC_VIS_FIRE, 110, 52, 90, 10
    AUTORADIOBUTTON "Line style", IDC_VIS_LINE, 206, 52, 90, 10
    AUTORADIOBUTTON "Thick bands", IDC_VIS_THICK, 14, 64, 90, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Thin bands", IDC_VIS_THIN, 110, 64, 90, 10
    AUTOCHECKBOX    "Show peaks", IDC_VIS_PEAKS, 14, 76, 90, 10, WS_GROUP | WS_TABSTOP
    GROUPBOX        "Oscilloscope", IDC_STATIC, 7, 97, 319, 28
    AUTORADIOBUTTON "Dots", IDC_VIS_DOTS, 14, 109, 90, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Lines", IDC_VIS_LINES, 110, 109, 90, 10
    AUTORADIOBUTTON "Solid", IDC_VIS_SOLID, 206, 109, 90, 10
    GROUPBOX        "Speed", IDC_STATIC, 7, 130, 319, 64
    LTEXT           "Refresh rate:", IDC_STATIC, 14, 145, 60, 8
    CONTROL         "", IDC_VIS_REFRESH, "msctls_trackbar32", TBS_AUTOTICKS | WS_GROUP | WS_TABSTOP, 76, 142, 150, 14
    LTEXT           "", IDC_VIS_REFRESH_TXT, 232, 145, 80, 8
    LTEXT           "Analyzer falloff:", IDC_STATIC, 14, 161, 60, 8
    CONTROL         "", IDC_VIS_FALLOFF, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 76, 158, 150, 14
    LTEXT           "", IDC_VIS_FALLOFF_TXT, 232, 161, 80, 8
    LTEXT           "Peaks falloff:", IDC_STATIC, 14, 177, 60, 8
    CONTROL         "", IDC_VIS_PFALLOFF, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 76, 174, 150, 14
    LTEXT           "", IDC_VIS_PFALLOFF_TXT, 232, 177, 80, 8
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION COMPONENT_VERSION_RC
 PRODUCTVERSION COMPONENT_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x2L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "foobar2000 component: " COMPONENT_NAME
            VALUE "FileVersion", COMPONENT_VERSION
            VALUE "InternalName", "foo_winamp_skins"
            VALUE "OriginalFilename", COMPONENT_FILENAME
            VALUE "ProductName", COMPONENT_NAME
            VALUE "ProductVersion", COMPONENT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
