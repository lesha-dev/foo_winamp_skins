#include <winres.h>
#include "version.h"
#include "resource.h"

IDD_PREFS DIALOGEX 0, 0, 332, 276
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Skins:", IDC_STATIC, 7, 7, 130, 8
    LISTBOX         IDC_SKIN_LIST, 7, 18, 130, 154, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Preview:", IDC_STATIC, 143, 7, 183, 8
    CONTROL         "", IDC_PREVIEW, "Static", SS_OWNERDRAW, 143, 18, 183, 72
    EDITTEXT        IDC_SKIN_INFO, 143, 94, 183, 78, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT           "Folder:", IDC_STATIC, 7, 180, 26, 8
    EDITTEXT        IDC_FOLDER, 35, 178, 193, 12, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Open folder", IDC_OPEN_FOLDER, 232, 177, 48, 14
    PUSHBUTTON      "Refresh", IDC_REFRESH, 283, 177, 43, 14
    PUSHBUTTON      "Load from file...", IDC_LOAD_FILE, 7, 195, 70, 14
    PUSHBUTTON      "Unload", IDC_UNLOAD, 81, 195, 50, 14
    GROUPBOX        "Options", IDC_STATIC, 7, 216, 319, 54
    AUTOCHECKBOX    "Winamp hotkeys (Z X C V B L, arrows, Ctrl+D/A/W)", IDC_WINAMP_HOTKEYS, 14, 228, 300, 10
    AUTOCHECKBOX    "Enable balance DSP", IDC_BALANCE_DSP, 14, 240, 300, 10
    LTEXT           "Balance center snap:", IDC_STATIC, 14, 254, 72, 8
    EDITTEXT        IDC_BALANCE_SNAP, 88, 252, 26, 12, ES_NUMBER
    LTEXT           "%", IDC_STATIC, 117, 254, 10, 8
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION COMPONENT_VERSION_RC
 PRODUCTVERSION COMPONENT_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x2L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "foobar2000 component: " COMPONENT_NAME
            VALUE "FileVersion", COMPONENT_VERSION
            VALUE "InternalName", "foo_winamp_skins"
            VALUE "OriginalFilename", COMPONENT_FILENAME
            VALUE "ProductName", COMPONENT_NAME
            VALUE "ProductVersion", COMPONENT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
